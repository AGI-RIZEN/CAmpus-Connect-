NODE_ENV=development
PORT=4000

# --- Postgres (Prisma) ---
# Local/Docker: set both to the same value.
# Neon: DATABASE_URL = the pooled connection string, DIRECT_URL = the direct (unpooled) one —
# click "Connect" on your Neon project, there's a toggle for pooled vs. direct.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_connect?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/campus_connect?schema=public

# --- Redis (ioredis) ---
# Local/Docker: redis://localhost:6379
# Upstash: use rediss:// (TLS), not redis:// — the connection string Upstash shows you already
# has the right scheme, just don't downgrade it.
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Brevo SMTP relay ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_PASS=your-brevo-smtp-key
MAIL_FROM="Campus Connect <no-reply@campusconnect.app>"

# --- CORS ---
# Comma-separated list of allowed origins, or * for all (dev convenience)
CORS_ORIGIN=*
